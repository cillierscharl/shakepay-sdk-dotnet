<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>ShakePay</RootNamespace>
    <Version>1.1.0</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Contracts mirror ShakePay's JSON and aren't individually documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>Charl Cilliers</Authors>
    <Title>shakepay_sdk_dotnet</Title>
    <Description>Unofficial .NET SDK for the ShakePay API.</Description>
    <PackageProjectUrl>https://github.com/cillierscharl/shakepay-sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cillierscharl/shakepay-sdk-dotnet</RepositoryUrl>
    <PackageIcon>shakepay-512.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>shakepay</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShakePay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
    <None Include="Assets\shakepay-512.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
